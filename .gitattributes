# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# PowerShell scripts standard CRLF for Windows compatibility
*.ps1 text eol=crlf

# Documentation, web files and CI workflows LF standard
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pfx binary
*.p12 binary
